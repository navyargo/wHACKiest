{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/web/*"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.mts",
    "playwright.config.ts"
  ]
}