# --- Database (docker compose up -d gives you this) ---
DATABASE_URL="postgresql://carerelay:carerelay@localhost:5432/carerelay"
# Used by `pnpm test` (integration tests reset this database). Created by prisma/init-test-db.sql.
TEST_DATABASE_URL="postgresql://carerelay:carerelay@localhost:5432/carerelay_test"

# --- App ---
# Public URL of the app. The in-app agents connect to ${APP_URL}/api/mcp with the MCP SDK client.
APP_URL="http://localhost:3000"
# true = demo control bar, virtual clock, scenario launcher, one-click demo logins.
# Demo passwords only work when this is true.
DEMO_MODE="true"
# Run the care sweep every minute inside the server process.
SCHEDULER_ENABLED="true"

# --- AI (optional) ---
# Leave empty to use the offline rule-based provider ("Offline AI mode — rule-based").
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- MCP stdio (Claude Desktop / MCP Inspector) ---
# A seeded demo token (DEMO_MODE only). See README for the per-user tokens.
CARERELAY_MCP_TOKEN="crt_demo_ravi_0000000000000000000000"

# --- ElevenLabs (optional, sponsor track) ---
# Without a key the "Listen" and voice-escalation buttons are hidden.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# --- Storage ---
# "local" (default, ./storage) or "s3"
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage"
AWS_REGION=""
S3_BUCKET=""
